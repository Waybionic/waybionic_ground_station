<?xml version="1.0"?>
<package format="3">
  <name>waybionic_camera_tools</name>
  <version>0.1.0</version>
  <description>ROS2 image-stream latency monitor and diagnostics publisher.</description>

  <maintainer email="gkong0520@gmail.com">Gianna Kong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
