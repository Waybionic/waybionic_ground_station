<?xml version="1.0"?>
<robot name="waybionic_old_arm_prototype">
  <!-- Simplified old-arm prototype. Dimensions are supplied millimetres converted to metres. -->
  <material name="base_gray"><color rgba="0.32 0.36 0.40 1"/></material>
  <material name="arm_blue"><color rgba="0.08 0.35 0.78 1"/></material>
  <material name="joint_yellow"><color rgba="0.95 0.65 0.10 1"/></material>
  <material name="tool_red"><color rgba="0.85 0.18 0.16 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.12 0.12 0.07"/></geometry>
      <material name="base_gray"/>
    </visual>
  </link>

  <link name="base_rotation_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
      <material name="joint_yellow"/>
    </visual>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotation_link"/>
    <origin xyz="0 0 0.07"/>
    <axis xyz="0 0 1"/>
    <!-- physical servo range 0..270 deg, zero 33.5 deg, direction +1 -->
    <limit lower="-0.584685" upper="4.127131" effort="10" velocity="2.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.06 0 0"/>
      <geometry><box size="0.12 0.04 0.04"/></geometry>
      <material name="arm_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry>
      <material name="joint_yellow"/>
    </visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_rotation_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0.025 0 0.07"/>
    <axis xyz="0 1 0"/>
    <!-- physical servo range 0..112.5 deg, zero 112.5 deg, direction -1 -->
    <limit lower="0" upper="1.963495" effort="10" velocity="2.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.025 0 0"/>
      <geometry><box size="0.05 0.035 0.035"/></geometry>
      <material name="arm_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.045"/></geometry>
      <material name="joint_yellow"/>
    </visual>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.12 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- physical servo range 90..270 deg, zero 151.5 deg, direction +1 -->
    <limit lower="-1.073377" upper="2.277655" effort="10" velocity="2.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.04 0.03 0.03"/></geometry>
      <material name="joint_yellow"/>
    </visual>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.05 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- physical servo range 0..270 deg, zero 27.5 deg, direction +1 -->
    <limit lower="-0.479966" upper="4.232083" effort="5" velocity="3.0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="0.025 0 0"/>
      <geometry><cylinder radius="0.014" length="0.05"/></geometry>
      <material name="tool_red"/>
    </visual>
  </link>
  <joint name="wrist_to_end_effector" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector"/>
    <origin xyz="0.04 0 0"/>
  </joint>
</robot>
