<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF for the WayBionic arm (full_arm_smaller.urdf, mechanical drop 2026-09-05).

  The robot name MUST match the <robot name=...> in the URDF, otherwise
  MoveIt refuses to load the semantic description.

  This plans over the ARTICULATED model, not the raw export. The export
  (waybionic_description/urdf/full-arm-smaller.urdf) parents all twelve parts
  to the assembly root, so it has no chain for a group to walk.

  NOTE ON DOF: this arm has 5 revolute joints (joint1..joint5). Five DOF cannot
  reach an arbitrary 6-DOF pose, so IK stays position-only - see
  config/kinematics.yaml.

  UNVERIFIED - READ THIS BEFORE TRUSTING ANY PLAN. The supplied export gave no
  parent/child relationships at all. The chain below was inferred, not
  delivered, as were the joint pivots, joint1's axis and every limit. See the
  header of waybionic_description/urdf/full_arm_smaller.urdf for exactly what
  is measured and what is assumed.
-->
<robot name="full-arm-smaller">

  <!-- ===== Planning group ===== -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool"/>
  </group>

  <!-- ===== Named poses ===== -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="-0.7854"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0.7854"/>
    <joint name="joint5" value="0"/>
  </group_state>

  <!-- ===== World attachment ===== -->
  <!-- The URDF root link is "world"; anchor it to the planning frame. -->
  <virtual_joint name="virtual_joint" type="fixed"
                 parent_frame="world" child_link="world"/>

  <!-- ===== Collision matrix =====
       Only the six structural links carry collision geometry; the drive and
       fastener links are visual-only, so the checker ignores them and they
       need no entries here.

       Pairs below were not guessed - they come from an oriented-bounding-box
       separating-axis test over the URDF's collision boxes. -->

  <!-- Adjacent links are always in contact at their shared joint. -->
  <disable_collisions link1="base_link" link2="sweep"    reason="Adjacent"/>
  <disable_collisions link1="sweep"     link2="shoulder" reason="Adjacent"/>
  <disable_collisions link1="shoulder"  link2="elbow"    reason="Adjacent"/>
  <disable_collisions link1="elbow"     link2="forearm"  reason="Adjacent"/>
  <disable_collisions link1="forearm"   link2="tool"     reason="Adjacent"/>

  <!-- Not adjacent, but colliding in 417 of 441 sampled (joint2, joint3) pairs
       - 95% of the range, including BOTH named states above. The elbow nests
       inside the sweep gearbox's bounding box, so this is mostly an artifact
       of approximating both with coarse boxes. Without this entry, planning
       cannot even start from home. Revisit if mechanical supplies a tighter
       sweep housing, or if these two links get finer collision geometry. -->
  <disable_collisions link1="sweep"     link2="elbow"    reason="Never"/>

</robot>
