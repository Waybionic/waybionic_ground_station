<?xml version="1.0"?>
<!--
  Wraps waybionic_description's articulated model and layers a ros2_control
  block on top of it. The base URDF is included unmodified, so nothing in
  waybionic_description has to change to support MoveIt.

  Mock hardware (mock_components/GenericSystem) echoes commands back as state,
  which lets you plan AND execute in RViz with no physical arm attached.

  This loads full_arm_smaller.urdf, NOT the raw export. The export
  (urdf/full-arm-smaller.urdf) has no kinematic chain, so no planning group can
  be built on it - see that file's header for the full list of what is measured
  and what is inferred here.

  Five joints. Command bounds must match the <limit> tags in
  full_arm_smaller.urdf, or the mock hardware accepts commands the model
  forbids. Both are the same UNVERIFIED +/-1.5708 placeholder, pending real
  travel figures from mechanical.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="full-arm-smaller">

  <xacro:include filename="$(find waybionic_description)/urdf/full_arm_smaller.urdf"/>

  <!-- One identical block per joint; xacro keeps the five in step.
       lo/hi rather than min/max: those shadow xacro built-ins and emit
       "redefining global symbol" warnings on every expansion. -->
  <xacro:macro name="waybionic_joint" params="name lo:=-1.5708 hi:=1.5708">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lo}</param>
        <param name="max">${hi}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="WaybionicMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>

    <xacro:waybionic_joint name="joint1"/>
    <xacro:waybionic_joint name="joint2"/>
    <xacro:waybionic_joint name="joint3"/>
    <xacro:waybionic_joint name="joint4"/>
    <xacro:waybionic_joint name="joint5"/>
  </ros2_control>

</robot>
