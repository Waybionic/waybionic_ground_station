Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: waybionic_rviz_plugins/DiagnosticsPanel
    Name: Engineering Monitor
    Diagnostics Topic: /diagnostics
    Use Mock Diagnostics: true
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (50 mm)
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 12
      Color: 155; 155; 155
      Alpha: 0.45
      Reference Frame: <Fixed Frame>
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: -0.066
      Line Style:
        Value: Lines
        Line Width: 0.001
    - Class: rviz_default_plugins/RobotModel
      Name: Old Arm (Video Reference Model)
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/Axes
      Name: Wrist Target Frame
      Enabled: true
      Reference Frame: old_arm_tool_frame
      Length: 0.035
      Radius: 0.0015
  Enabled: true
  Global Options:
    Fixed Frame: old_arm_base_link
    Background Color: 238; 240; 242
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.78
      Pitch: 0.45
      Yaw: 0.80
      Near Clip Distance: 0.005
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0.08
        Y: 0
        Z: 0.13
    Saved: ~
Window Geometry:
  Width: 1440
  Height: 960
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false