Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 742
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: waybionic_rviz_plugins/DiagnosticsPanel
    Diagnostics Topic: /diagnostics
    Name: Engineering Monitor
    Use Mock Diagnostics: true
  - Class: waybionic_rviz_plugins/MotionTestPanel
    Name: MotionTestPanel
