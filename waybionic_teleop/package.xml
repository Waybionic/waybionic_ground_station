<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waybionic_teleop</name>
  <version>0.1.0</version>
  <description>Xbox controller teleoperation and MKS CAN joint drives, simulated or real, for the WayBionic arm.</description>
  <maintainer email="solimanyassin@gmail.com">Yassin Soliman</maintainer>
  <license>Apache-2.0</license>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-can</exec_depend>
  <!-- The WayBionic carrier's USB serial link (slcan_bus.py). -->
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <!-- slcan_sim runs the carrier's bridge code for test_slcan_bus.py. -->
  <test_depend>waybionic_can</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
